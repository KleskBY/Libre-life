textures/models/hassassin/chrome_latex
{
	program chrome
	surfaceparm trans
	{
		map textures/models/hassassin/chrome_latex
		tcGen environment
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		alphaFunc GT0
		depthWrite
		alphaGen entity
		rgbGen const ( 0.8 0.8 0.8 )
	}
	{
		map $lightmap
		rgbGen identity
		blendFunc GL_DST_COLOR GL_ZERO
	}
}

