
textures/models/hassassin/quiver
{
	surfaceparm trans
	{
		map textures/models/hassassin/quiver
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		alphaFunc GT0
		depthWrite
		alphaGen entity
		rgbGen lightingDiffuse
	}
}

