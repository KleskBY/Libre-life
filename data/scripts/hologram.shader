//DP supports only 2 maps per shader
textures/models/holo/headside
{
	surfaceparm trans
	surfaceparm nomarks

	deformVertexes wave 10 triangle 0 .1 0 9.1

	{
		map textures/models/holo/headside
		blendFunc GL_SRC_ALPHA GL_ONE
		rgbGen wave sin 0.75 0.12 0 0.9
		alphaGen entity
	}
	{
		map textures/models/holo/headside
		blendFunc GL_DST_COLOR GL_ONE
		rgbGen const ( 0.15 0.55 0.75 )
		alphaGen entity
	}
	{
		map textures/models/holo/hologram_scanlines
		blendFunc GL_ONE GL_ONE
		rgbGen wave square 0.10 0.05 0 0.6
		tcMod scale 1 40
		tcMod scroll 0 -1.6
	}
}

